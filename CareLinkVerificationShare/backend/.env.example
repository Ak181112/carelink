# Copy this file to .env and fill in real values. Never commit .env.

# ---- server ----
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# ---- database ----
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/carelinkplus?retryWrites=true&w=majority

# ---- auth ----
JWT_SECRET=<a long random string>
JWT_EXPIRE=7d

# ---- email (Brevo / any SMTP relay) ----
EMAIL_HOST=smtp-relay.brevo.com
EMAIL_PORT=587
EMAIL_USER=<smtp username>
EMAIL_PASS=<smtp password>
EMAIL_FROM=CareLink+ <no-reply@example.com>

# ---- payments (PayHere) ----
# Card payments stay switched off until the two values below are set; bookings
# can still be settled in cash without any of these.
#
# Sandbox account: https://sandbox.payhere.lk/  (free)
#   Settings -> Domains & Credentials -> add your domain, then copy the
#   Merchant ID and generate a Merchant Secret.
PAYHERE_MERCHANT_ID=1221149
PAYHERE_MERCHANT_SECRET=<merchant secret from the PayHere dashboard>

# true = sandbox.payhere.lk (test cards), false = live www.payhere.lk
PAYHERE_SANDBOX=true
PAYHERE_CURRENCY=LKR

# Where PayHere posts the payment result. It calls this from ITS OWN servers, so
# localhost will never work — expose the backend with a tunnel while developing:
#   ngrok http 5000
# then set the public URL here.
SERVER_URL=http://localhost:5000
PAYHERE_NOTIFY_URL=https://<your-ngrok-id>.ngrok-free.app/api/payments/notify

# ---- PayHere refunds (optional) ----
# Refunding from inside the admin panel needs a PayHere "Business App":
#   PayHere dashboard -> Integrations -> Create App (enable Payment Retrieval
#   and Refund permissions).
# Without these the app still works; refunds are then done from the PayHere
# dashboard instead.
PAYHERE_APP_ID=
PAYHERE_APP_SECRET=
