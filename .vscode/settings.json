{
  // Tailwind v4 keeps its configuration in CSS: @theme, @custom-variant and
  // @apply are real Tailwind syntax that VS Code's built-in CSS language
  // server does not know, so it reports each one as "Unknown at rule". The
  // build compiles them fine, so these would be editor-only false positives.
  "css.lint.unknownAtRules": "ignore",
  "scss.lint.unknownAtRules": "ignore",

  // Project vocabulary: product names, the Sri Lankan place this runs in, and
  // the libraries in package.json. Each one was confirmed to actually appear
  // in the source before being added, so this list stays honest.
  "cSpell.words": [
    "bcryptjs",
    "Brevo",
    "carelink",
    "CareLink",
    "chargedback",
    "Geist",
    "jsonwebtoken",
    "Kurunegala",
    "Multer",
    "md5sig",
    "ngrok",
    "nodemon",
    "Nodemailer",
    "payhere",
    "PayHere",
    "prerender",
    "prerendered",
    "shadcn",
    "Tesseract"
  ]
}
